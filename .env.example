# Local inference server (Ollama by default)
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=qwen3-coder
LLM_PROVIDER=qwen

# Optional: authorized credentials for L2 authenticated assessment.
# Leave EMPTY for passive mode. Never commit real values.
ASSESSMENT_USERNAME=
ASSESSMENT_PASSWORD=

# Optional: written authorization reference required by GOV-02 before
# anything beyond passive mode is permitted.
AUTHORIZATION_REFERENCE=
